# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Runtime data (SQLite, config, logs, screenshots)
data/*
!data/.gitkeep

# Tooling
.pytest_cache/
# pytest 的临时根目录（中断或 --basetemp 时会留在仓库根）；注意 .gitignore 不支持行尾注释
pytest-of-*/
.coverage
htmlcov/
.idea/
.vscode/
.DS_Store
Thumbs.db

# UI verification harness (local only: node_modules, screenshots)
.verify/node_modules/
.verify/shots/
.verify/package-lock.json

# Local bookkeeping
.trash/
